# PMD_UNKNOWN_TENANT_HTTPS_WILDCARD_R1 (EXAMPLE; NOT AUTO-INSTALLED)
#
# Prerequisites:
#  1) DNS wildcard A/AAAA for *.paymydine.com points to the public VPS.
#  2) Valid wildcard TLS certificate for *.paymydine.com issued via DNS-01.
#  3) No existing competing HTTPS wildcard server_name in nginx -T.
#  4) Make backups, run nginx -t, and verify named active tenants still win.
#
# Replace the TWO CERTIFICATE PLACEHOLDERS before enabling this vhost.
# The exact vhosts for registered tenants win over this wildcard match.
# Unregistered hosts fail the central tenant-access check and show the
# static unavailable page on their own HTTPS hostname.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name *.paymydine.com;

    ssl_certificate /REPLACE/WITH/WILDCARD/fullchain.pem;
    ssl_certificate_key /REPLACE/WITH/WILDCARD/privkey.pem;

    root /var/www/paymydine;

    auth_request /__pmd_tenant_access_check;
    include /etc/nginx/snippets/pmd-tenant-unavailable-r1.conf;

    location = /__pmd_tenant_access_check {
        internal;
        auth_request off;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /var/www/paymydine/index.php;
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_param DOCUMENT_ROOT /var/www/paymydine;
        fastcgi_param REQUEST_METHOD GET;
        fastcgi_param REQUEST_URI /__pmd/tenant-access;
        fastcgi_param QUERY_STRING "";
        fastcgi_param HTTP_X_PMD_TENANT_ACCESS_INTERNAL 1;
        fastcgi_param HTTP_X_PMD_TENANT_HOST $host;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
    }

    # Run the access gate; do not publish a customer app on an unknown vhost.
    location / { try_files /__pmd_unknown_public_file_never_created =404; }
}
