# Example only. Do not paste blindly into the live Nginx configuration.
# Tenant selection for this isolated PM2 process comes from
# PMD_TENANT_HOST_OVERRIDE=mimoza.paymydine.com, not from a user-controlled header.
server {
    listen 443 ssl;
    server_name menu-v2-preview.paymydine.com;

    location / {
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_pass http://127.0.0.1:3002;
    }
}
