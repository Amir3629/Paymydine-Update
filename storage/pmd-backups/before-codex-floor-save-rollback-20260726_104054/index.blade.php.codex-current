        if (body) {
            body.style.setProperty(
                'overflow-y',
                'auto',
                'important'
            );

            body.style.setProperty(
                'height',
                'auto',
                'important'
            );

            body.style.setProperty(
                'max-height',
                'none',
                'important'
            );
