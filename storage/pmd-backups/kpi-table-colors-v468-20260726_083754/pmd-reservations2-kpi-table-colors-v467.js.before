(function () {
  'use strict';

  var route = String(
    window.location.pathname || ''
  ).replace(/\/+$/, '');

  if (
    route !== '/admin/reservations' &&
    route !== '/admin/reservations2'
  ) {
    return;
  }

  if (
    window.PMDReservations2KpiTableColorsV467
  ) {
    return;
  }

  var VERSION = '4.6.7';

  var FLOOR_ID =
    'pmd-r2-shared-floor-canvas-v310';

  var STYLE_ID =
    'pmd-reservations2-kpi-table-colors-v467-style';

  var observer = null;
  var scheduled = false;
  var running = false;


  function clean(value) {
    return String(
      value == null ? '' : value
    )
      .replace(/\s+/g, ' ')
      .trim();
  }


  function rgb(value) {
    var match = String(
      value || ''
    ).match(
      /rgba?\(\s*(\d+)\s*,\s*(\d+)\s*,\s*(\d+)/
    );

    if (!match) {
      return null;
    }

    return {
      r: Number(match[1]),
      g: Number(match[2]),
      b: Number(match[3])
    };
  }


  function isTransparent(value) {
    return (
      !value ||
      value === 'transparent' ||
      value === 'rgba(0, 0, 0, 0)'
    );
  }


  function visible(element) {
    if (!element) {
      return false;
    }

    var style =
      window.getComputedStyle(element);

    return (
      style.display !== 'none' &&
      style.visibility !== 'hidden' &&
      element.getClientRects().length > 0
    );
  }


  /*
   * =====================================================
   * FLOOR TABLE DETECTION
   * =====================================================
   */

  function floorRoot() {
    return document.getElementById(
      FLOOR_ID
    );
  }


  function tableCandidates() {
    var root = floorRoot();

    if (!root) {
      return [];
    }

    var candidates =
      Array.prototype.slice.call(
        root.querySelectorAll('*')
      );

    return candidates.filter(
      function (element) {
        if (!visible(element)) {
          return false;
        }

        var text = clean(
          element.textContent
        );

        if (!/^\d{1,3}$/.test(text)) {
          return false;
        }

        /*
         * Do not select a child number when its parent
         * is the actual colored table.
         */
        if (
          element.children.length > 0
        ) {
          return false;
        }

        var rect =
          element.getBoundingClientRect();

        if (
          rect.width < 40 ||
          rect.width > 190 ||
          rect.height < 35 ||
          rect.height > 190
        ) {
          return false;
        }

        var node = element;

        for (
          var level = 0;
          level < 4 && node;
          level += 1
        ) {
          var nodeRect =
            node.getBoundingClientRect();

          var color = rgb(
            getComputedStyle(node)
              .backgroundColor
          );

          if (
            color &&
            nodeRect.width >= 65 &&
            nodeRect.width <= 190 &&
            nodeRect.height >= 55 &&
            nodeRect.height <= 190 &&
            (
              color.r > color.g + 25 ||
              color.g > color.r + 20
            )
          ) {
            element.__pmdTableRoot =
              node;

            return true;
          }

          node = node.parentElement;
        }

        return false;
      }
    );
  }


  function tableRoots() {
    var roots = [];

    tableCandidates().forEach(
      function (numberElement) {
        var root =
          numberElement.__pmdTableRoot;

        if (
          root &&
          roots.indexOf(root) === -1
        ) {
          roots.push(root);
        }
      }
    );

    return roots;
  }


  function rememberOriginalState(element) {
    var saved =
      element.getAttribute(
        'data-pmd-v467-original-state'
      );

    if (saved) {
      return saved;
    }

    var color = rgb(
      getComputedStyle(element)
        .backgroundColor
    );

    var state = 'unknown';

    if (color) {
      if (
        color.r > color.g + 30 &&
        color.r > color.b + 20
      ) {
        state = 'reserved';
      } else if (
        color.g > color.r + 20 &&
        color.g > color.b + 10
      ) {
        state = 'free';
      }
    }

    element.setAttribute(
      'data-pmd-v467-original-state',
      state
    );

    return state;
  }


  function updateTables() {
    var counts = {
      total: 0,
      free: 0,
      reserved: 0,
      unknown: 0
    };

    tableRoots().forEach(
      function (table) {
        var state =
          rememberOriginalState(table);

        counts.total += 1;

        table.removeAttribute(
          'data-pmd-v467-free'
        );

        table.removeAttribute(
          'data-pmd-v467-reserved'
        );

        if (state === 'free') {
          counts.free += 1;

          table.setAttribute(
            'data-pmd-v467-free',
            'true'
          );
        } else if (
          state === 'reserved'
        ) {
          counts.reserved += 1;

          table.setAttribute(
            'data-pmd-v467-reserved',
            'true'
          );
        } else {
          counts.unknown += 1;
        }
      }
    );

    return counts;
  }


  /*
   * =====================================================
   * KPI DETECTION
   * =====================================================
   */

  function findTextElement(patterns) {
    var elements =
      document.querySelectorAll(
        'h1,h2,h3,h4,h5,h6,strong,b,span,p,div'
      );

    for (
      var index = 0;
      index < elements.length;
      index += 1
    ) {
      var element = elements[index];

      if (!visible(element)) {
        continue;
      }

      var text = clean(
        element.textContent
      ).toLowerCase();

      var matched =
        patterns.some(
          function (pattern) {
            return (
              text === pattern ||
              text.indexOf(pattern) !== -1
            );
          }
        );

      if (matched) {
        return element;
      }
    }

    return null;
  }


  function findColoredCard(label) {
    var node = label;

    for (
      var level = 0;
      level < 9 && node;
      level += 1
    ) {
      var rect =
        node.getBoundingClientRect();

      var background =
        getComputedStyle(node)
          .backgroundColor;

      var color = rgb(background);

      if (
        color &&
        !isTransparent(background) &&
        rect.width >= 250 &&
        rect.width <= 650 &&
        rect.height >= 100 &&
        rect.height <= 260 &&
        (
          color.r > 100 ||
          color.g > 100 ||
          color.b > 100
        )
      ) {
        return node;
      }

      node = node.parentElement;
    }

    return null;
  }


  function replaceLabel(
    element,
    newValue
  ) {
    if (!element) {
      return;
    }

    var directTextChanged = false;

    Array.prototype.forEach.call(
      element.childNodes,
      function (node) {
        if (
          !directTextChanged &&
          node.nodeType === 3 &&
          clean(node.textContent)
        ) {
          node.textContent =
            newValue;

          directTextChanged = true;
        }
      }
    );

    if (!directTextChanged) {
      element.textContent =
        newValue;
    }
  }


  function findMainNumber(card) {
    if (!card) {
      return null;
    }

    var candidates =
      Array.prototype.slice.call(
        card.querySelectorAll(
          'strong,b,span,div'
        )
      ).filter(
        function (element) {
          return (
            visible(element) &&
            /^\s*(?:\d+|—|-)\s*$/.test(
              clean(element.textContent)
            )
          );
        }
      );

    candidates.sort(
      function (first, second) {
        var firstSize = parseFloat(
          getComputedStyle(first)
            .fontSize
        ) || 0;

        var secondSize = parseFloat(
          getComputedStyle(second)
            .fontSize
        ) || 0;

        return secondSize - firstSize;
      }
    );

    return candidates[0] || null;
  }


  function findDescription(
    card,
    patterns
  ) {
    if (!card) {
      return null;
    }

    var candidates =
      card.querySelectorAll(
        'p,small,span,div'
      );

    for (
      var index = 0;
      index < candidates.length;
      index += 1
    ) {
      var element =
        candidates[index];

      var text = clean(
        element.textContent
      ).toLowerCase();

      if (
        patterns.some(
          function (pattern) {
            return text.indexOf(
              pattern
            ) !== -1;
          }
        )
      ) {
        return element;
      }
    }

    return null;
  }


  function isGerman() {
    var lang = String(
      document.documentElement.lang || ''
    ).toLowerCase();

    return (
      lang.indexOf('de') === 0 ||
      document.body.textContent
        .indexOf(
          'Heutige Reservierungen'
        ) !== -1
    );
  }


  function updateKpis(counts) {
    var todayLabel =
      findTextElement([
        "today's reservations",
        'today’s reservations',
        'heutige reservierungen'
      ]);

    var todayCard =
      findColoredCard(todayLabel);

    if (todayCard) {
      todayCard.setAttribute(
        'data-pmd-v467-today-blue',
        'true'
      );
    }

    var pendingLabel =
      findTextElement([
        'pending confirmations',
        'ausstehende bestätigungen'
      ]);

    var pendingCard =
      findColoredCard(pendingLabel);

    if (!pendingLabel || !pendingCard) {
      return;
    }

    var german = isGerman();

    replaceLabel(
      pendingLabel,
      german
        ? 'Freie Tische'
        : 'Free Tables'
    );

    var value =
      findMainNumber(pendingCard);

    if (value) {
      value.textContent =
        String(counts.free);

      value.setAttribute(
        'data-pmd-v467-free-count',
        'true'
      );
    }

    var description =
      findDescription(
        pendingCard,
        [
          'requiring confirmation',
          'bestätigt werden müssen',
          'bestätigt werden'
        ]
      );

    if (description) {
      replaceLabel(
        description,
        german
          ? 'Aktuell verfügbare Tische'
          : 'Tables currently available'
      );
    }

    pendingCard.setAttribute(
      'data-pmd-v467-free-green',
      'true'
    );
  }


  /*
   * =====================================================
   * CSS
   * =====================================================
   */

  function installStyle() {
    var previous =
      document.getElementById(
        STYLE_ID
      );

    if (previous) {
      previous.remove();
    }

    var style =
      document.createElement('style');

    style.id = STYLE_ID;

    style.textContent = `
/* Today's Reservations KPI becomes blue. */
[data-pmd-v467-today-blue="true"] {
  background: #32b2d8 !important;
  background-color: #32b2d8 !important;
  border-color: #087aa5 !important;
  color: #061725 !important;
}

[data-pmd-v467-today-blue="true"] * {
  color: #061725 !important;
}

/* Free Tables KPI becomes green. */
[data-pmd-v467-free-green="true"] {
  background: #22c96f !important;
  background-color: #22c96f !important;
  border-color: #087c4d !important;
  color: #061b14 !important;
}

[data-pmd-v467-free-green="true"] * {
  color: #061b14 !important;
}

/* Free tables remain green. */
[data-pmd-v467-free="true"] {
  background: #22c96f !important;
  background-color: #22c96f !important;
  border-color: #087c4d !important;
  color: #061b14 !important;
}

/* Reserved tables become blue. */
[data-pmd-v467-reserved="true"] {
  background: #32b2d8 !important;
  background-color: #32b2d8 !important;
  border-color: #087aa5 !important;
  color: #061725 !important;
}

[data-pmd-v467-free="true"] *,
[data-pmd-v467-reserved="true"] * {
  color: inherit !important;
}

/* Preserve selected-table outline. */
[data-pmd-v467-free="true"].is-selected,
[data-pmd-v467-reserved="true"].is-selected,
[data-pmd-v467-free="true"][aria-selected="true"],
[data-pmd-v467-reserved="true"][aria-selected="true"] {
  outline: 3px solid #153b5a !important;
  outline-offset: 3px !important;
}
`;

    document.head.appendChild(style);
  }


  function apply() {
    if (running) {
      return;
    }

    running = true;

    try {
      var counts =
        updateTables();

      updateKpis(counts);
    } finally {
      running = false;
    }
  }


  function schedule() {
    if (scheduled) {
      return;
    }

    scheduled = true;

    requestAnimationFrame(
      function () {
        scheduled = false;
        apply();
      }
    );
  }


  function boot() {
    installStyle();
    apply();

    [
      150,
      500,
      1000,
      2000
    ].forEach(function (delay) {
      setTimeout(
        apply,
        delay
      );
    });

    observer =
      new MutationObserver(schedule);

    observer.observe(
      document.getElementById(
        'pmd-reservations2'
      ) || document.body,
      {
        childList: true,
        subtree: true
      }
    );

    window
      .PMDReservations2KpiTableColorsV467 = {
        version: VERSION,

        refresh: apply,

        audit: function () {
          return {
            version: VERSION,

            todayBlue:
              Boolean(
                document.querySelector(
                  '[data-pmd-v467-today-blue="true"]'
                )
              ),

            freeKpiGreen:
              Boolean(
                document.querySelector(
                  '[data-pmd-v467-free-green="true"]'
                )
              ),

            freeTables:
              document.querySelectorAll(
                '[data-pmd-v467-free="true"]'
              ).length,

            reservedTables:
              document.querySelectorAll(
                '[data-pmd-v467-reserved="true"]'
              ).length,

            freeCount:
              document.querySelector(
                '[data-pmd-v467-free-count="true"]'
              )
                ? document.querySelector(
                    '[data-pmd-v467-free-count="true"]'
                  ).textContent
                : null
          };
        }
      };

    console.info(
      '[PMD KPI + Table Colors V4.6.7] Ready',
      window
        .PMDReservations2KpiTableColorsV467
        .audit()
    );
  }


  if (
    document.readyState === 'loading'
  ) {
    document.addEventListener(
      'DOMContentLoaded',
      boot,
      { once: true }
    );
  } else {
    boot();
  }
})();
