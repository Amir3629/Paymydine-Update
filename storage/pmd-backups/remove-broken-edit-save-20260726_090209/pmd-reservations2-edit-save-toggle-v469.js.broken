(function () {
  'use strict';

  var route = String(
    window.location.pathname || ''
  ).replace(/\/+$/, '');

  if (
    route !== '/admin/reservations' &&
    route !== '/admin/reservations2'
  ) {
    return;
  }

  if (window.PMDReservations2EditSaveToggleV469) {
    return;
  }

  var VERSION = '4.6.9';

  var FLOOR_ID =
    'pmd-r2-shared-floor-canvas-v310';

  var TOOLBAR_ID =
    'pmd-r2-floor-toolbar-v316';

  var STYLE_ID =
    'pmd-reservations2-edit-save-toggle-v469-style';

  var observer = null;
  var scheduled = false;


  function floor() {
    return document.getElementById(
      FLOOR_ID
    );
  }


  function toolbar() {
    return document.getElementById(
      TOOLBAR_ID
    );
  }


  function nativeControl(selector) {
    var root = floor();

    if (!root) {
      return null;
    }

    return Array.prototype.slice.call(
      root.querySelectorAll(selector)
    ).find(function (element) {
      return !element.closest(
        '#' + TOOLBAR_ID
      );
    }) || null;
  }


  function nativeEdit() {
    return nativeControl(
      '[data-floor-edit]'
    );
  }


  function nativeSave() {
    return nativeControl(
      '[data-floor-save]'
    );
  }


  function proxyEdit() {
    var root = toolbar();

    return root
      ? root.querySelector(
          '[data-pmd-r2-tool="edit"]'
        )
      : null;
  }


  function proxySave() {
    var root = toolbar();

    return root
      ? root.querySelector(
          '[data-pmd-r2-tool="save"]'
        )
      : null;
  }


  function nativeSaveVisible() {
    var save = nativeSave();

    if (!save) {
      return false;
    }

    var style = getComputedStyle(save);

    return (
      !save.hidden &&
      style.display !== 'none' &&
      style.visibility !== 'hidden'
    );
  }


  function isEditing() {
    var root = floor();
    var edit = nativeEdit();

    if (!root) {
      return false;
    }

    return Boolean(
      root.classList.contains(
        'is-editing'
      ) ||
      root.getAttribute(
        'data-floor-editing'
      ) === 'true' ||
      (
        edit &&
        edit.getAttribute(
          'aria-pressed'
        ) === 'true'
      ) ||
      nativeSaveVisible()
    );
  }


  function language() {
    var lang = String(
      document.documentElement.lang || ''
    ).toLowerCase();

    if (
      lang.indexOf('de') === 0 ||
      document.body.textContent
        .indexOf('Reservierungen') !== -1
    ) {
      return 'de';
    }

    return 'en';
  }


  function label(mode) {
    var german =
      language() === 'de';

    if (mode === 'save') {
      return german
        ? 'Speichern'
        : 'Save';
    }

    return german
      ? 'Bearbeiten'
      : 'Edit';
  }


  function installStyle() {
    var previous =
      document.getElementById(
        STYLE_ID
      );

    if (previous) {
      previous.remove();
    }

    var style =
      document.createElement('style');

    style.id = STYLE_ID;

    style.textContent = `
/*
 * V469 uses one button for both Edit and Save.
 */
#${TOOLBAR_ID}
[data-pmd-r2-tool="save"] {
  display: none !important;
  visibility: hidden !important;
  pointer-events: none !important;
}

#${TOOLBAR_ID}
[data-pmd-r2-tool="edit"] {
  display: inline-flex !important;
  visibility: visible !important;
  align-items: center !important;
  justify-content: center !important;
}

#${TOOLBAR_ID}
[data-pmd-r2-tool="edit"]
[data-pmd-toggle-mode="save"] {
  background: #102f2b !important;
  border-color: #102f2b !important;
  color: #ffffff !important;
}

#${FLOOR_ID}.is-editing
.pmd-floor-v1__table {
  cursor: grab !important;
  touch-action: none !important;
}

#${FLOOR_ID}.is-editing
.pmd-floor-v1__table:active {
  cursor: grabbing !important;
}
`;

    document.head.appendChild(style);
  }


  function sync() {
    var button = proxyEdit();
    var saveButton = proxySave();
    var editing = isEditing();

    if (saveButton) {
      saveButton.hidden = true;

      saveButton.style.setProperty(
        'display',
        'none',
        'important'
      );

      saveButton.setAttribute(
        'aria-hidden',
        'true'
      );

      saveButton.setAttribute(
        'tabindex',
        '-1'
      );
    }

    if (!button) {
      return;
    }

    button.textContent = label(
      editing ? 'save' : 'edit'
    );

    button.setAttribute(
      'data-pmd-toggle-mode',
      editing ? 'save' : 'edit'
    );

    button.setAttribute(
      'aria-pressed',
      editing ? 'true' : 'false'
    );

    button.setAttribute(
      'aria-label',
      label(
        editing ? 'save' : 'edit'
      ) + ' floor layout'
    );

    button.title = editing
      ? 'Save floor layout'
      : 'Edit floor layout';
  }


  function clickNative(element) {
    if (!element) {
      return false;
    }

    /*
     * HTMLElement.click() uses the native Floor Map
     * event handler and is safer than rebuilding its
     * internal edit/drag/save state ourselves.
     */
    element.click();

    return true;
  }


  function handleToggle(event) {
    event.preventDefault();
    event.stopPropagation();
    event.stopImmediatePropagation();

    var editing = isEditing();

    if (editing) {
      var save = nativeSave();

      if (!save) {
        console.error(
          '[PMD Edit/Save Toggle V4.6.9] ' +
          'Native Save control not found'
        );

        return;
      }

      clickNative(save);
    } else {
      var edit = nativeEdit();

      if (!edit) {
        console.error(
          '[PMD Edit/Save Toggle V4.6.9] ' +
          'Native Edit control not found'
        );

        return;
      }

      clickNative(edit);
    }

    [
      0,
      50,
      150,
      400,
      900
    ].forEach(function (delay) {
      setTimeout(sync, delay);
    });
  }


  function replaceProxyEdit() {
    var current = proxyEdit();

    if (!current) {
      return null;
    }

    if (
      current.getAttribute(
        'data-pmd-single-edit-save-v469'
      ) === 'true'
    ) {
      return current;
    }

    /*
     * Cloning removes the old V316 onclick property,
     * which previously only acted as a basic proxy.
     */
    var replacement =
      current.cloneNode(true);

    replacement.removeAttribute(
      'onclick'
    );

    replacement.setAttribute(
      'data-pmd-single-edit-save-v469',
      'true'
    );

    current.parentNode.replaceChild(
      replacement,
      current
    );

    replacement.addEventListener(
      'click',
      handleToggle,
      true
    );

    return replacement;
  }


  function bindNativeSynchronization() {
    [
      nativeEdit(),
      nativeSave()
    ].filter(Boolean).forEach(
      function (element) {
        if (
          element.getAttribute(
            'data-pmd-v469-observed'
          ) === 'true'
        ) {
          return;
        }

        element.setAttribute(
          'data-pmd-v469-observed',
          'true'
        );

        element.addEventListener(
          'click',
          function () {
            [
              0,
              50,
              150,
              500
            ].forEach(function (delay) {
              setTimeout(sync, delay);
            });
          }
        );
      }
    );
  }


  function apply() {
    installStyle();
    replaceProxyEdit();
    bindNativeSynchronization();
    sync();
  }


  function schedule() {
    if (scheduled) {
      return;
    }

    scheduled = true;

    requestAnimationFrame(
      function () {
        scheduled = false;
        apply();
      }
    );
  }


  function audit() {
    var edit = nativeEdit();
    var save = nativeSave();
    var proxy = proxyEdit();

    return {
      version: VERSION,

      floorFound:
        Boolean(floor()),

      toolbarFound:
        Boolean(toolbar()),

      nativeEditFound:
        Boolean(edit),

      nativeSaveFound:
        Boolean(save),

      nativeEditPressed:
        edit
          ? edit.getAttribute(
              'aria-pressed'
            )
          : null,

      nativeSaveHidden:
        save
          ? Boolean(save.hidden)
          : null,

      editing:
        isEditing(),

      proxyMode:
        proxy
          ? proxy.getAttribute(
              'data-pmd-toggle-mode'
            )
          : null,

      separateSaveVisible:
        proxySave()
          ? getComputedStyle(
              proxySave()
            ).display !== 'none'
          : false,

      layoutUrl:
        floor()
          ? floor().getAttribute(
              'data-layout-url'
            )
          : null
    };
  }


  function boot() {
    apply();

    [
      100,
      350,
      800,
      1600,
      3000
    ].forEach(function (delay) {
      setTimeout(apply, delay);
    });

    observer =
      new MutationObserver(schedule);

    observer.observe(
      document.getElementById(
        'pmd-reservations2'
      ) || document.body,
      {
        childList: true,
        subtree: true,
        attributes: true,
        attributeFilter: [
          'hidden',
          'class',
          'aria-pressed'
        ]
      }
    );

    window
      .PMDReservations2EditSaveToggleV469 = {
        version: VERSION,
        refresh: apply,
        audit: audit,

        enterEdit: function () {
          if (!isEditing()) {
            clickNative(nativeEdit());
          }

          setTimeout(sync, 50);
        },

        save: function () {
          if (isEditing()) {
            clickNative(nativeSave());
          }

          setTimeout(sync, 50);
        }
      };

    console.info(
      '[PMD Reservations2 Edit/Save Toggle V4.6.9] Ready',
      audit()
    );
  }


  if (
    document.readyState === 'loading'
  ) {
    document.addEventListener(
      'DOMContentLoaded',
      boot,
      { once: true }
    );
  } else {
    boot();
  }
})();
