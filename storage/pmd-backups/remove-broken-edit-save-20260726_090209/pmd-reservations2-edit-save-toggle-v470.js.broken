(function () {
  'use strict';

  var route = String(
    window.location.pathname || ''
  ).replace(/\/+$/, '');

  if (
    route !== '/admin/reservations' &&
    route !== '/admin/reservations2'
  ) {
    return;
  }

  if (window.PMDReservations2EditSaveToggleV470) {
    return;
  }

  var VERSION = '4.7.0';

  var FLOOR_ID =
    'pmd-r2-shared-floor-canvas-v310';

  var TOOLBAR_ID =
    'pmd-r2-floor-toolbar-v316';

  var STYLE_ID =
    'pmd-reservations2-edit-save-toggle-v470-style';

  var saving = false;
  var scheduled = false;
  var observer = null;


  function floor() {
    return document.getElementById(
      FLOOR_ID
    );
  }


  function toolbar() {
    return document.getElementById(
      TOOLBAR_ID
    );
  }


  function proxyEdit() {
    var root = toolbar();

    return root
      ? root.querySelector(
          '[data-pmd-r2-tool="edit"]'
        )
      : null;
  }


  function proxySave() {
    var root = toolbar();

    return root
      ? root.querySelector(
          '[data-pmd-r2-tool="save"]'
        )
      : null;
  }


  function nativeControl(selector) {
    var root = floor();

    if (!root) {
      return null;
    }

    return Array.prototype.slice.call(
      root.querySelectorAll(selector)
    ).find(function (element) {
      return !element.closest(
        '#' + TOOLBAR_ID
      );
    }) || null;
  }


  function nativeEdit() {
    return nativeControl(
      '[data-floor-edit]'
    );
  }


  function nativeSave() {
    return nativeControl(
      '[data-floor-save]'
    );
  }


  function isEditing() {
    var root = floor();
    var edit = nativeEdit();

    return Boolean(
      root &&
      (
        root.classList.contains(
          'is-editing'
        ) ||
        root.getAttribute(
          'data-floor-editing'
        ) === 'true' ||
        (
          edit &&
          edit.getAttribute(
            'aria-pressed'
          ) === 'true'
        )
      )
    );
  }


  function language() {
    var lang = String(
      document.documentElement.lang || ''
    ).toLowerCase();

    if (
      lang.indexOf('de') === 0 ||
      document.body.textContent
        .indexOf('Reservierungen') !== -1
    ) {
      return 'de';
    }

    return 'en';
  }


  function buttonLabel(mode) {
    var german =
      language() === 'de';

    if (mode === 'saving') {
      return german
        ? 'Speichern…'
        : 'Saving…';
    }

    if (mode === 'save') {
      return german
        ? 'Speichern'
        : 'Save';
    }

    return german
      ? 'Bearbeiten'
      : 'Edit';
  }


  function installStyle() {
    var previous =
      document.getElementById(
        STYLE_ID
      );

    if (previous) {
      previous.remove();
    }

    var style =
      document.createElement('style');

    style.id = STYLE_ID;

    style.textContent = `
/*
 * V470:
 * Keep exactly the existing toolbar button appearance.
 * Only the label and function change.
 */
#${TOOLBAR_ID}
[data-pmd-r2-tool="save"] {
  display: none !important;
  visibility: hidden !important;
  pointer-events: none !important;
}

#${TOOLBAR_ID}
[data-pmd-r2-tool="edit"] {
  display: inline-flex !important;
  visibility: visible !important;
  opacity: 1 !important;
}

#${TOOLBAR_ID}
[data-pmd-r2-tool="edit"][disabled] {
  cursor: wait !important;
  opacity: .72 !important;
}

#${FLOOR_ID}.is-editing
.pmd-floor-v1__table {
  cursor: grab !important;
  touch-action: none !important;
}

#${FLOOR_ID}.is-editing
.pmd-floor-v1__table:active {
  cursor: grabbing !important;
}

.pmd-r2-floor-save-message-v470 {
  position: fixed;
  right: 24px;
  bottom: 24px;
  z-index: 100000;
  max-width: 420px;
  padding: 14px 18px;
  border: 1px solid #b42318;
  border-radius: 12px;
  background: #fff;
  color: #b42318;
  box-shadow: 0 16px 40px rgba(15, 23, 42, .18);
  font: 700 14px/1.45 inherit;
}
`;

    document.head.appendChild(style);
  }


  function showError(message) {
    document
      .querySelectorAll(
        '.pmd-r2-floor-save-message-v470'
      )
      .forEach(function (element) {
        element.remove();
      });

    var notice =
      document.createElement('div');

    notice.className =
      'pmd-r2-floor-save-message-v470';

    notice.textContent =
      'Floor layout was not saved: ' +
      String(message || 'Unknown error');

    document.body.appendChild(notice);

    setTimeout(function () {
      notice.remove();
    }, 9000);
  }


  function tableId(element) {
    var candidates = [
      element.getAttribute(
        'data-table-id'
      ),
      element.getAttribute(
        'data-floor-table'
      ),
      element.getAttribute(
        'data-pmd-floor-table'
      ),
      element.getAttribute(
        'data-id'
      ),
      element.dataset
        ? element.dataset.tableId
        : null,
      element.dataset
        ? element.dataset.floorTable
        : null,
      element.dataset
        ? element.dataset.pmdFloorTable
        : null
    ];

    for (
      var index = 0;
      index < candidates.length;
      index += 1
    ) {
      var value =
        String(
          candidates[index] == null
            ? ''
            : candidates[index]
        ).trim();

      if (/^\d+$/.test(value)) {
        return Number(value);
      }
    }

    return null;
  }


  function positionValue(element, property) {
    var inlineValue =
      parseFloat(
        element.style[property]
      );

    if (
      Number.isFinite(inlineValue)
    ) {
      return inlineValue;
    }

    var computedValue =
      parseFloat(
        getComputedStyle(element)[property]
      );

    if (
      Number.isFinite(computedValue)
    ) {
      return computedValue;
    }

    if (property === 'left') {
      return Number(element.offsetLeft) || 0;
    }

    if (property === 'top') {
      return Number(element.offsetTop) || 0;
    }

    return 0;
  }


  function dimensionValue(
    element,
    property
  ) {
    var inlineValue =
      parseFloat(
        element.style[property]
      );

    if (
      Number.isFinite(inlineValue) &&
      inlineValue > 0
    ) {
      return inlineValue;
    }

    if (property === 'width') {
      return Number(
        element.offsetWidth
      ) || 108;
    }

    return Number(
      element.offsetHeight
    ) || 88;
  }


  function collectTables() {
    var root = floor();

    if (!root) {
      throw new Error(
        'Floor Map was not found'
      );
    }

    var elements =
      Array.prototype.slice.call(
        root.querySelectorAll(
          '.pmd-floor-v1__table'
        )
      );

    var seen = Object.create(null);
    var tables = [];

    elements.forEach(function (element) {
      var id = tableId(element);

      /*
       * Ignore merged visual-only cards or elements
       * without a real database table ID.
       */
      if (
        !id ||
        seen[String(id)]
      ) {
        return;
      }

      seen[String(id)] = true;

      tables.push({
        id: id,
        table_id: id,

        floor_x: Math.max(
          0,
          Math.round(
            positionValue(
              element,
              'left'
            )
          )
        ),

        floor_y: Math.max(
          0,
          Math.round(
            positionValue(
              element,
              'top'
            )
          )
        ),

        floor_width: Math.max(
          40,
          Math.round(
            dimensionValue(
              element,
              'width'
            )
          )
        ),

        floor_height: Math.max(
          40,
          Math.round(
            dimensionValue(
              element,
              'height'
            )
          )
        )
      });
    });

    if (!tables.length) {
      throw new Error(
        'No real Floor Map table IDs were detected'
      );
    }

    return tables;
  }


  function csrfToken() {
    var meta =
      document.querySelector(
        'meta[name="csrf-token"]'
      );

    if (
      meta &&
      meta.content
    ) {
      return meta.content;
    }

    var input =
      document.querySelector(
        'input[name="_token"]'
      );

    return input
      ? input.value
      : '';
  }


  function layoutUrl() {
    var root = floor();

    var value =
      root &&
      root.getAttribute(
        'data-layout-url'
      );

    if (value) {
      return value;
    }

    return (
      window.location.origin +
      '/admin/pmd-owner-dashboard-floor-layout'
    );
  }


  function saveVisibleLayout() {
    var tables =
      collectTables();

    var headers = {
      Accept: 'application/json',
      'Content-Type': 'application/json',
      'X-Requested-With':
        'XMLHttpRequest'
    };

    var token =
      csrfToken();

    if (token) {
      headers['X-CSRF-TOKEN'] =
        token;
    }

    return fetch(
      layoutUrl(),
      {
        method: 'POST',
        credentials: 'same-origin',
        redirect: 'manual',
        headers: headers,
        body: JSON.stringify({
          tables: tables
        })
      }
    ).then(function (response) {
      if (
        response.type ===
        'opaqueredirect'
      ) {
        throw new Error(
          'The save request was redirected. ' +
          'The session or CSRF token may be invalid.'
        );
      }

      return response.text().then(
        function (text) {
          var payload = null;

          try {
            payload =
              JSON.parse(text);
          } catch (error) {
            throw new Error(
              'Server returned HTTP ' +
              response.status +
              ' instead of JSON: ' +
              text.slice(0, 180)
            );
          }

          if (!response.ok) {
            throw new Error(
              payload.message ||
              (
                'HTTP ' +
                response.status
              )
            );
          }

          if (
            !payload ||
            payload.ok === false
          ) {
            throw new Error(
              payload &&
              payload.message
                ? payload.message
                : 'Save endpoint rejected the layout'
            );
          }

          /*
           * updated can be 0 when coordinates already match.
           * That is still a valid successful response.
           */
          return {
            payload: payload,
            tables: tables
          };
        }
      );
    });
  }


  function setButtonState(mode) {
    var button =
      proxyEdit();

    if (!button) {
      return;
    }

    button.textContent =
      buttonLabel(mode);

    button.setAttribute(
      'data-pmd-toggle-mode',
      mode
    );

    button.disabled =
      mode === 'saving';

    button.setAttribute(
      'aria-busy',
      mode === 'saving'
        ? 'true'
        : 'false'
    );

    button.setAttribute(
      'aria-pressed',
      mode === 'save'
        ? 'true'
        : 'false'
    );
  }


  function sync() {
    var separateSave =
      proxySave();

    if (separateSave) {
      separateSave.hidden = true;

      separateSave.style.setProperty(
        'display',
        'none',
        'important'
      );

      separateSave.setAttribute(
        'aria-hidden',
        'true'
      );

      separateSave.setAttribute(
        'tabindex',
        '-1'
      );
    }

    if (saving) {
      setButtonState('saving');
      return;
    }

    setButtonState(
      isEditing()
        ? 'save'
        : 'edit'
    );
  }


  function enterEditMode() {
    var edit =
      nativeEdit();

    if (!edit) {
      throw new Error(
        'Native Edit control was not found'
      );
    }

    edit.click();

    setTimeout(sync, 30);
    setTimeout(sync, 150);
  }


  function saveAndReload() {
    if (saving) {
      return;
    }

    saving = true;
    sync();

    saveVisibleLayout()
      .then(function (result) {
        console.info(
          '[PMD Floor Save V4.7.0] Saved',
          {
            submitted:
              result.tables.length,

            response:
              result.payload
          }
        );

        /*
         * Reload only after the endpoint confirms success.
         * This also resets the native private editing state.
         */
        window.location.reload();
      })
      .catch(function (error) {
        saving = false;
        sync();

        console.error(
          '[PMD Floor Save V4.7.0] Failed',
          error
        );

        showError(
          error && error.message
            ? error.message
            : error
        );
      });
  }


  function handleToggle(event) {
    event.preventDefault();
    event.stopPropagation();
    event.stopImmediatePropagation();

    try {
      if (isEditing()) {
        saveAndReload();
      } else {
        enterEditMode();
      }
    } catch (error) {
      saving = false;
      sync();

      console.error(
        '[PMD Edit/Save Toggle V4.7.0]',
        error
      );

      showError(
        error && error.message
          ? error.message
          : error
      );
    }
  }


  function installButton() {
    var current =
      proxyEdit();

    if (!current) {
      return;
    }

    if (
      current.getAttribute(
        'data-pmd-edit-save-v470'
      ) === 'true'
    ) {
      sync();
      return;
    }

    var replacement =
      current.cloneNode(true);

    replacement.removeAttribute(
      'style'
    );

    replacement.removeAttribute(
      'onclick'
    );

    replacement.setAttribute(
      'data-pmd-edit-save-v470',
      'true'
    );

    current.parentNode.replaceChild(
      replacement,
      current
    );

    replacement.addEventListener(
      'click',
      handleToggle,
      true
    );

    sync();
  }


  function apply() {
    installStyle();
    installButton();
    sync();
  }


  function schedule() {
    if (scheduled) {
      return;
    }

    scheduled = true;

    requestAnimationFrame(
      function () {
        scheduled = false;
        apply();
      }
    );
  }


  function audit() {
    var tables = [];

    try {
      tables =
        collectTables();
    } catch (error) {
      tables = [];
    }

    return {
      version: VERSION,

      floorFound:
        Boolean(floor()),

      toolbarFound:
        Boolean(toolbar()),

      nativeEditFound:
        Boolean(nativeEdit()),

      nativeSaveFound:
        Boolean(nativeSave()),

      editing:
        isEditing(),

      saving:
        saving,

      proxyMode:
        proxyEdit()
          ? proxyEdit().getAttribute(
              'data-pmd-toggle-mode'
            )
          : null,

      separateSaveVisible:
        proxySave()
          ? getComputedStyle(
              proxySave()
            ).display !== 'none'
          : false,

      layoutUrl:
        layoutUrl(),

      detectedSaveTables:
        tables.length,

      samplePayload:
        tables.slice(0, 3)
    };
  }


  function boot() {
    apply();

    [
      100,
      350,
      800,
      1600,
      3000
    ].forEach(function (delay) {
      setTimeout(apply, delay);
    });

    observer =
      new MutationObserver(schedule);

    observer.observe(
      document.getElementById(
        'pmd-reservations2'
      ) || document.body,
      {
        childList: true,
        subtree: true,
        attributes: true,
        attributeFilter: [
          'hidden',
          'class',
          'aria-pressed'
        ]
      }
    );

    window
      .PMDReservations2EditSaveToggleV470 = {
        version: VERSION,
        audit: audit,
        refresh: apply,
        collectTables:
          collectTables,
        save:
          saveAndReload
      };

    console.info(
      '[PMD Reservations2 Edit/Save Toggle V4.7.0] Ready',
      audit()
    );
  }


  if (
    document.readyState === 'loading'
  ) {
    document.addEventListener(
      'DOMContentLoaded',
      boot,
      { once: true }
    );
  } else {
    boot();
  }
})();
