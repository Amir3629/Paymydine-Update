/* PMD Reservations2 single date button V4.3.1 */
(function () {
  'use strict';

  var route = String(window.location.pathname || '').replace(/\/+$/, '');

  if (route !== '/admin/reservations2') {
    return;
  }

  var NEW_BUTTON_ID = 'pmd-r2-date-button-v430';
  var OLD_BUTTON_ID = 'pmd-r2-date-button-v318';
  var OLD_PANEL_ID = 'pmd-r2-date-panel-v318';
  var applying = false;
  var scheduled = false;

  function clean(value) {
    return String(value == null ? '' : value)
      .replace(/\s+/g, ' ')
      .trim();
  }

  function isVisible(element) {
    if (!element) {
      return false;
    }

    var style = window.getComputedStyle(element);

    return (
      style.display !== 'none' &&
      style.visibility !== 'hidden' &&
      element.getClientRects().length > 0
    );
  }

  function findCreateButton(newButton, oldButton) {
    var containers = [
      newButton && newButton.parentElement,
      oldButton && oldButton.parentElement,
      document.querySelector('[data-pmd-header-actions]'),
      document.querySelector('.pmd-r2__hero-actions'),
      document.querySelector('.pmd-r2-clean-header__actions'),
      document.querySelector('.navbar .navbar-nav'),
      document.querySelector('header')
    ].filter(Boolean);

    var selectors = [
      '[data-r2-create]',
      '[data-create-reservation]',
      '[aria-label*="create" i]',
      '[title*="create" i]',
      '[aria-label*="add" i]',
      '[title*="add" i]',
      'a[href*="/admin/reservations/create"]',
      'a[href*="/admin/reservations2/create"]'
    ];

    for (var c = 0; c < containers.length; c += 1) {
      var container = containers[c];

      for (var s = 0; s < selectors.length; s += 1) {
        var direct = container.querySelector(selectors[s]);

        if (
          direct &&
          direct.id !== NEW_BUTTON_ID &&
          direct.id !== OLD_BUTTON_ID
        ) {
          return direct;
        }
      }

      var controls = Array.prototype.slice.call(
        container.querySelectorAll('button, a')
      );

      var plusButton = controls.find(function (control) {
        if (
          control.id === NEW_BUTTON_ID ||
          control.id === OLD_BUTTON_ID
        ) {
          return false;
        }

        var text = clean(control.textContent);
        var label = clean(
          control.getAttribute('aria-label') ||
          control.getAttribute('title')
        ).toLowerCase();

        return (
          text === '+' ||
          text === '＋' ||
          /create|add new|new reservation/.test(label)
        );
      });

      if (plusButton) {
        return plusButton;
      }
    }

    return null;
  }

  function removeLegacyCalendar() {
    document
      .querySelectorAll(
        '#' + OLD_BUTTON_ID + ', #' + OLD_PANEL_ID
      )
      .forEach(function (element) {
        element.remove();
      });
  }

  function apply() {
    if (applying) {
      return;
    }

    applying = true;

    try {
      var newButton = document.getElementById(NEW_BUTTON_ID);
      var oldButton = document.getElementById(OLD_BUTTON_ID);

      if (!newButton) {
        return;
      }

      var createButton = findCreateButton(newButton, oldButton);

      if (createButton && createButton.parentElement) {
        if (createButton.nextElementSibling !== newButton) {
          createButton.insertAdjacentElement('afterend', newButton);
        }
      } else if (oldButton && oldButton.parentElement) {
        oldButton.insertAdjacentElement('beforebegin', newButton);
      }

      removeLegacyCalendar();

      newButton.hidden = false;
      newButton.style.display = 'inline-flex';
      newButton.removeAttribute('aria-hidden');

      if (!isVisible(newButton)) {
        newButton.style.visibility = 'visible';
        newButton.style.opacity = '1';
      }

      newButton.setAttribute(
        'data-pmd-single-date-authority',
        'v4.3.1'
      );

      document.documentElement.setAttribute(
        'data-pmd-r2-date-authority',
        'v430'
      );
    } finally {
      applying = false;
    }
  }

  function schedule() {
    if (scheduled) {
      return;
    }

    scheduled = true;

    window.requestAnimationFrame(function () {
      scheduled = false;
      apply();
    });
  }

  function boot() {
    apply();

    var observer = new MutationObserver(function (mutations) {
      var relevant = mutations.some(function (mutation) {
        if (mutation.type !== 'childList') {
          return false;
        }

        return Array.prototype.some.call(
          mutation.addedNodes,
          function (node) {
            if (!node || node.nodeType !== 1) {
              return false;
            }

            return (
              node.id === OLD_BUTTON_ID ||
              node.id === OLD_PANEL_ID ||
              node.id === NEW_BUTTON_ID ||
              (
                node.querySelector &&
                node.querySelector(
                  '#' +
                    OLD_BUTTON_ID +
                    ',#' +
                    OLD_PANEL_ID +
                    ',#' +
                    NEW_BUTTON_ID
                )
              )
            );
          }
        );
      });

      if (relevant) {
        schedule();
      }
    });

    observer.observe(document.body, {
      childList: true,
      subtree: true
    });

    window.PMDReservations2SingleDateButtonV431 = {
      version: '4.3.1',
      refresh: schedule,
      audit: function () {
        var newButton = document.getElementById(NEW_BUTTON_ID);

        return {
          version: '4.3.1',
          newButton: Boolean(newButton),
          newButtonVisible: isVisible(newButton),
          oldButton: Boolean(
            document.getElementById(OLD_BUTTON_ID)
          ),
          oldPanel: Boolean(
            document.getElementById(OLD_PANEL_ID)
          ),
          authority:
            document.documentElement.getAttribute(
              'data-pmd-r2-date-authority'
            ),
          previousControl:
            newButton &&
            newButton.previousElementSibling
              ? clean(
                  newButton.previousElementSibling.textContent ||
                  newButton.previousElementSibling.getAttribute(
                    'aria-label'
                  )
                )
              : null
        };
      }
    };

    console.info(
      '[PMD Reservations2 Single Date Button V4.3.1] Ready',
      window.PMDReservations2SingleDateButtonV431.audit()
    );
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot, {
      once: true
    });
  } else {
    boot();
  }
})();

/* PMD Reservations2 header date authority V4.3.2 */
(function () {
  'use strict';

  var route = String(window.location.pathname || '').replace(/\/+$/, '');

  if (route !== '/admin/reservations2') {
    return;
  }

  var NEW_ID = 'pmd-r2-date-button-v430';
  var OLD_ID = 'pmd-r2-date-button-v318';
  var OLD_PANEL_ID = 'pmd-r2-date-panel-v318';
  var STYLE_ID = 'pmd-r2-header-date-v432-style';
  var busy = false;
  var queued = false;

  function clean(value) {
    return String(value == null ? '' : value)
      .replace(/\s+/g, ' ')
      .trim();
  }

  function installStyle() {
    var style = document.getElementById(STYLE_ID);

    if (!style) {
      style = document.createElement('style');
      style.id = STYLE_ID;
      document.head.appendChild(style);
    }

    style.textContent =
      '#' + OLD_ID + ',#' + OLD_PANEL_ID + '{display:none!important;visibility:hidden!important;opacity:0!important;pointer-events:none!important}' +

      '#' + NEW_ID + '{' +
        'position:static!important;' +
        'inset:auto!important;' +
        'top:auto!important;' +
        'right:auto!important;' +
        'bottom:auto!important;' +
        'left:auto!important;' +
        'transform:none!important;' +
        'margin:0!important;' +
        'z-index:auto!important;' +
        'display:inline-flex!important;' +
        'align-items:center!important;' +
        'justify-content:center!important;' +
        'gap:0!important;' +
        'width:84px!important;' +
        'height:84px!important;' +
        'min-width:84px!important;' +
        'max-width:84px!important;' +
        'padding:0!important;' +
        'border-radius:22px!important;' +
        'box-shadow:none!important;' +
      '}' +

      '#' + NEW_ID + ' span{display:none!important}' +

      '#' + NEW_ID + ' svg{' +
        'width:38px!important;' +
        'height:38px!important;' +
        'margin:0!important;' +
      '}';

  }

  function findCreateButton(oldButton) {
    var parent = oldButton && oldButton.parentElement;

    if (!parent) {
      var bell =
        document.querySelector(
          'button[aria-label*="notification" i],button[title*="notification" i]'
        );

      parent = bell && bell.parentElement;
    }

    if (!parent) {
      return null;
    }

    var controls = Array.prototype.slice.call(
      parent.querySelectorAll('button,a')
    );

    return controls.find(function (control) {
      if (control.id === NEW_ID || control.id === OLD_ID) {
        return false;
      }

      var text = clean(control.textContent);
      var label = clean(
        control.getAttribute('aria-label') ||
        control.getAttribute('title')
      ).toLowerCase();

      return (
        text === '+' ||
        text === '＋' ||
        /create|add reservation|new reservation/.test(label)
      );
    }) || null;
  }

  function removeLegacy() {
    document
      .querySelectorAll('#' + OLD_ID + ',#' + OLD_PANEL_ID)
      .forEach(function (node) {
        node.remove();
      });
  }

  function apply() {
    if (busy) {
      return;
    }

    busy = true;

    try {
      installStyle();

      var newButton = document.getElementById(NEW_ID);
      var oldButton = document.getElementById(OLD_ID);

      if (!newButton) {
        return;
      }

      var createButton = findCreateButton(oldButton);

      if (
        createButton &&
        createButton.parentElement &&
        createButton.nextElementSibling !== newButton
      ) {
        createButton.insertAdjacentElement('afterend', newButton);
      }

      newButton.hidden = false;
      newButton.removeAttribute('aria-hidden');
      newButton.setAttribute(
        'data-pmd-r2-header-date-authority',
        'v4.3.2'
      );

      removeLegacy();

      document.documentElement.setAttribute(
        'data-pmd-r2-date-authority',
        'v430-header'
      );
    } finally {
      busy = false;
    }
  }

  function schedule() {
    if (queued) {
      return;
    }

    queued = true;

    requestAnimationFrame(function () {
      queued = false;
      apply();
    });
  }

  function boot() {
    apply();

    var observer = new MutationObserver(function () {
      schedule();
    });

    observer.observe(document.body, {
      childList: true,
      subtree: true
    });

    window.setInterval(apply, 1000);

    window.PMDReservations2HeaderDateV432 = {
      refresh: apply,

      audit: function () {
        var button = document.getElementById(NEW_ID);
        var previous = button && button.previousElementSibling;

        return {
          version: '4.3.2',
          newButton: Boolean(button),
          oldButton: Boolean(document.getElementById(OLD_ID)),
          oldPanel: Boolean(document.getElementById(OLD_PANEL_ID)),
          parentChildren:
            button && button.parentElement
              ? Array.prototype.map.call(
                  button.parentElement.children,
                  function (node) {
                    return node.id ||
                      clean(
                        node.getAttribute('aria-label') ||
                        node.getAttribute('title') ||
                        node.textContent
                      );
                  }
                )
              : [],
          previousControl:
            previous
              ? clean(
                  previous.getAttribute('aria-label') ||
                  previous.getAttribute('title') ||
                  previous.textContent
                )
              : null,
          position:
            button ? getComputedStyle(button).position : null,
          authority:
            document.documentElement.getAttribute(
              'data-pmd-r2-date-authority'
            )
        };
      }
    };

    console.info(
      '[PMD Reservations2 Header Date V4.3.2] Ready',
      window.PMDReservations2HeaderDateV432.audit()
    );
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot, {
      once: true
    });
  } else {
    boot();
  }
})();

/* PMD_DATE_BUTTON_BRIDGE_V454_BEGIN */
(function () {
  'use strict';

  var route = String(
    window.location.pathname || ''
  ).replace(/\/+$/, '');

  if (
    route !== '/admin/reservations' &&
    route !== '/admin/reservations2'
  ) {
    return;
  }

  if (window.PMDReservations2DateButtonBridgeV454) {
    return;
  }

  var VERSION = '4.5.4';

  var VISIBLE_BUTTON_ID =
    'pmd-r2-date-button-v430';

  var WORKING_BUTTON_ID =
    'pmd-r2-date-button-v318';

  var WORKING_PANEL_ID =
    'pmd-r2-date-panel-v318';

  var UNUSED_PANEL_ID =
    'pmd-r2-date-filter-v317';

  var STYLE_ID =
    'pmd-r2-date-button-bridge-v454-style';

  var workingButtonObserver = null;
  var pageObserver = null;
  var applying = false;

  function visibleButton() {
    return document.getElementById(
      VISIBLE_BUTTON_ID
    );
  }

  function workingButton() {
    return document.getElementById(
      WORKING_BUTTON_ID
    );
  }

  function workingPanel() {
    return document.getElementById(
      WORKING_PANEL_ID
    );
  }

  function closeUnusedPanel() {
    var panel = document.getElementById(
      UNUSED_PANEL_ID
    );

    if (!panel) {
      return;
    }

    panel.classList.remove('is-open');
    panel.setAttribute('aria-hidden', 'true');
  }

  function hideWorkingButtonOnly() {
    var button = workingButton();

    if (!button) {
      return null;
    }

    /*
     * دکمه مخفی می‌شود، ولی:
     * - حذف نمی‌شود
     * - disabled نمی‌شود
     * - پنل آن مخفی نمی‌شود
     * بنابراین button.click() همچنان کار می‌کند.
     */
    button.hidden = true;

    button.style.setProperty(
      'display',
      'none',
      'important'
    );

    button.style.setProperty(
      'visibility',
      'hidden',
      'important'
    );

    button.style.setProperty(
      'opacity',
      '0',
      'important'
    );

    button.style.setProperty(
      'position',
      'absolute',
      'important'
    );

    button.style.setProperty(
      'left',
      '-99999px',
      'important'
    );

    button.setAttribute(
      'aria-hidden',
      'true'
    );

    button.setAttribute(
      'tabindex',
      '-1'
    );

    button.setAttribute(
      'data-pmd-working-date-trigger',
      'v454'
    );

    return button;
  }

  function syncExpandedState() {
    var visible = visibleButton();
    var working = workingButton();

    if (!visible || !working) {
      return;
    }

    visible.setAttribute(
      'aria-expanded',
      working.getAttribute(
        'aria-expanded'
      ) === 'true'
        ? 'true'
        : 'false'
    );
  }

  function connectWorkingButtonObserver() {
    var working = workingButton();

    if (!working) {
      return;
    }

    if (
      workingButtonObserver &&
      workingButtonObserver.__pmdTarget === working
    ) {
      return;
    }

    if (workingButtonObserver) {
      workingButtonObserver.disconnect();
    }

    workingButtonObserver =
      new MutationObserver(function () {
        syncExpandedState();
      });

    workingButtonObserver.__pmdTarget =
      working;

    workingButtonObserver.observe(
      working,
      {
        attributes: true,
        attributeFilter: [
          'aria-expanded'
        ]
      }
    );
  }

  function apply() {
    if (applying) {
      return;
    }

    applying = true;

    try {
      var visible = visibleButton();
      var working = hideWorkingButtonOnly();
      var panel = workingPanel();

      closeUnusedPanel();

      if (panel) {
        /*
         * پنل سالم V318 را مخفی یا حذف نمی‌کنیم.
         */
        panel.removeAttribute('aria-hidden');

        panel.setAttribute(
          'data-pmd-date-panel-authority',
          'v454'
        );
      }

      if (!visible) {
        return;
      }

      visible.setAttribute(
        'aria-haspopup',
        'dialog'
      );

      visible.setAttribute(
        'aria-controls',
        WORKING_PANEL_ID
      );

      visible.setAttribute(
        'aria-label',
        'Reservation date range'
      );

      visible.setAttribute(
        'data-pmd-date-button-authority',
        'bridge-v454'
      );

      if (working) {
        syncExpandedState();
        connectWorkingButtonObserver();
      }
    } finally {
      applying = false;
    }
  }

  document.addEventListener(
    'click',
    function (event) {
      var visible = event.target.closest(
        '#' + VISIBLE_BUTTON_ID
      );

      if (!visible) {
        return;
      }

      /*
       * Handler اصلی V430 که پنل V317 را باز می‌کند
       * متوقف می‌شود؛ سپس همان دکمه سالم V318
       * به‌صورت برنامه‌ای کلیک می‌شود.
       */
      event.preventDefault();
      event.stopPropagation();
      event.stopImmediatePropagation();

      closeUnusedPanel();

      var working = hideWorkingButtonOnly();
      var panel = workingPanel();

      if (!working || !panel) {
        console.warn(
          '[PMD Date Button Bridge V4.5.4] ' +
          'Working V318 button or panel not found.',
          {
            workingButton: Boolean(working),
            workingPanel: Boolean(panel)
          }
        );

        return;
      }

      working.click();

      window.requestAnimationFrame(
        function () {
          syncExpandedState();

          panel.setAttribute(
            'data-pmd-opened-by',
            VISIBLE_BUTTON_ID
          );
        }
      );
    },
    true
  );

  function boot() {
    [
      'pmd-r2-date-button-proxy-v451-style',
      'pmd-r2-date-button-functional-v452-style',
      'pmd-r2-date-button-native-v453-style'
    ].forEach(function (id) {
      var style = document.getElementById(id);

      if (style) {
        style.remove();
      }
    });

    if (!document.getElementById(STYLE_ID)) {
      var style =
        document.createElement('style');

      style.id = STYLE_ID;

      /*
       * فقط دکمه V318 مخفی می‌شود.
       * هیچ CSSای به پنل V318 اعمال نمی‌شود.
       */
      style.textContent =
        '#' + WORKING_BUTTON_ID + '{' +
          'display:none!important;' +
          'visibility:hidden!important;' +
          'opacity:0!important;' +
          'position:absolute!important;' +
          'left:-99999px!important;' +
        '}';

      document.head.appendChild(style);
    }

    apply();

    pageObserver =
      new MutationObserver(function (mutations) {
        var relevant = mutations.some(
          function (mutation) {
            return Array.prototype.some.call(
              mutation.addedNodes,
              function (node) {
                if (
                  !node ||
                  node.nodeType !== 1
                ) {
                  return false;
                }

                return (
                  node.id === VISIBLE_BUTTON_ID ||
                  node.id === WORKING_BUTTON_ID ||
                  node.id === WORKING_PANEL_ID ||
                  (
                    node.querySelector &&
                    node.querySelector(
                      '#' + VISIBLE_BUTTON_ID +
                      ',#' + WORKING_BUTTON_ID +
                      ',#' + WORKING_PANEL_ID
                    )
                  )
                );
              }
            );
          }
        );

        if (relevant) {
          window.requestAnimationFrame(
            apply
          );
        }
      });

    pageObserver.observe(
      document.body,
      {
        childList: true,
        subtree: true
      }
    );

    window.PMDReservations2DateButtonBridgeV454 = {
      version: VERSION,

      refresh: apply,

      audit: function () {
        var visible = visibleButton();
        var working = workingButton();
        var panel = workingPanel();

        return {
          version: VERSION,
          visibleButton: Boolean(visible),
          workingButton: Boolean(working),
          workingButtonHidden: Boolean(
            working &&
            getComputedStyle(working)
              .display === 'none'
          ),
          workingPanel: Boolean(panel),
          workingPanelControls: panel
            ? panel.querySelectorAll(
                'button, input, select'
              ).length
            : 0,
          expanded:
            visible &&
            visible.getAttribute(
              'aria-expanded'
            ),
          authority:
            visible &&
            visible.getAttribute(
              'data-pmd-date-button-authority'
            )
        };
      }
    };

    console.info(
      '[PMD Reservations2 Date Button Bridge V4.5.4] Ready',
      window
        .PMDReservations2DateButtonBridgeV454
        .audit()
    );
  }

