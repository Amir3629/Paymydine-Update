(function () {
  'use strict';

  var route = String(
    window.location.pathname || ''
  ).replace(/\/+$/, '');

  if (
    route !== '/admin/reservations' &&
    route !== '/admin/reservations2'
  ) {
    return;
  }

  var VERSION = '4.6.0';

  var GRID_ID =
    'pmd-r2-reservation-grid-v320';

  var STYLE_ID =
    'pmd-simple-add-reservation-card-v460-style';


  function install() {
    var previous =
      document.getElementById(STYLE_ID);

    if (previous) {
      previous.remove();
    }

    var style =
      document.createElement('style');

    style.id = STYLE_ID;

    style.textContent = `
/*
 * Stretch cards within each grid row so the Add card
 * has the same height as the reservation cards.
 */
#${GRID_ID} {
  align-items: stretch !important;
}

#${GRID_ID} > .pmd-w5-card {
  height: 100% !important;
}

/*
 * Simple Add Reservation card
 */
#${GRID_ID} .pmd-r2-simple-add-card-v460 {
  position: relative !important;
  display: flex !important;
  align-items: stretch !important;
  justify-content: stretch !important;

  min-height: 100% !important;
  height: 100% !important;

  padding: 0 !important;
  overflow: hidden !important;

  border: 2px dashed #c9d9e7 !important;
  border-radius: 18px !important;

  background: #ffffff !important;
  box-shadow: 0 12px 30px rgba(20,40,62,.05) !important;

  transition:
    border-color .18s ease,
    background .18s ease,
    box-shadow .18s ease,
    transform .18s ease !important;
}

#${GRID_ID} .pmd-r2-simple-add-card-v460:hover {
  border-color: #21a8d8 !important;
  background: #f7fcff !important;
  box-shadow: 0 16px 38px rgba(20,120,165,.12) !important;
  transform: translateY(-2px) !important;
}

/*
 * Entire card is the link.
 */
#${GRID_ID} .pmd-r2-simple-add-link-v460 {
  position: relative !important;
  inset: auto !important;
  z-index: 3 !important;

  display: flex !important;
  flex: 1 1 auto !important;
  flex-direction: column !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 15px !important;

  width: 100% !important;
  min-height: 100% !important;
  padding: 36px 22px !important;

  color: #14283e !important;
  text-align: center !important;
  text-decoration: none !important;

  border-radius: inherit !important;
  outline: none !important;
}

/*
 * Center plus icon — blue like Pending Confirmations.
 */
#${GRID_ID} .pmd-r2-simple-add-icon-v460 {
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;

  width: 70px !important;
  height: 70px !important;

  border: 2px solid #21a8d8 !important;
  border-radius: 999px !important;

  background: #dff5fc !important;
  color: #087aa5 !important;

  font-size: 38px !important;
  font-weight: 500 !important;
  line-height: 1 !important;

  transition:
    transform .18s ease,
    background .18s ease,
    color .18s ease !important;
}

#${GRID_ID} .pmd-r2-simple-add-title-v460 {
  color: #14283e !important;
  font-size: 20px !important;
  font-weight: 950 !important;
  line-height: 1.2 !important;
}

#${GRID_ID}
.pmd-r2-simple-add-link-v460:hover
.pmd-r2-simple-add-icon-v460,
#${GRID_ID}
.pmd-r2-simple-add-link-v460:focus-visible
.pmd-r2-simple-add-icon-v460 {
  transform: scale(1.06) !important;
  background: #21a8d8 !important;
  color: #ffffff !important;
}

#${GRID_ID}
.pmd-r2-simple-add-link-v460:hover
.pmd-r2-simple-add-title-v460,
#${GRID_ID}
.pmd-r2-simple-add-link-v460:focus-visible
.pmd-r2-simple-add-title-v460 {
  color: #087aa5 !important;
}

/*
 * Remove inherited old Add-card components if another
 * script temporarily injects them.
 */
#${GRID_ID} .pmd-r2-simple-add-card-v460
.pmd-v35-card-head,

#${GRID_ID} .pmd-r2-simple-add-card-v460
.pmd-w5-card-top,

#${GRID_ID} .pmd-r2-simple-add-card-v460
.pmd-w5-meta,

#${GRID_ID} .pmd-r2-simple-add-card-v460
.pmd-w5-items,

#${GRID_ID} .pmd-r2-simple-add-card-v460
.pmd-w5-card-actions,

#${GRID_ID} .pmd-r2-simple-add-card-v460
> h2 {

  display: none !important;
}
`;

    document.head.appendChild(style);
  }


  function boot() {
    install();

    window.PMDSimpleAddReservationCardV460 = {
      version: VERSION,
      refresh: install,

      audit: function () {
        var grid =
          document.getElementById(GRID_ID);

        var card =
          grid &&
          grid.querySelector(
            '.pmd-r2-simple-add-card-v460'
          );

        return {
          version: VERSION,
          card: Boolean(card),
          link: Boolean(
            card &&
            card.querySelector(
              '.pmd-r2-simple-add-link-v460'
            )
          ),
          oldMetaVisible: Boolean(
            card &&
            card.querySelector(
              '.pmd-w5-meta'
            )
          )
        };
      }
    };

    console.info(
      '[PMD Simple Add Reservation Card V4.6.0] Ready',
      window
        .PMDSimpleAddReservationCardV460
        .audit()
    );
  }


  if (
    document.readyState === 'loading'
  ) {
    document.addEventListener(
      'DOMContentLoaded',
      boot,
      { once: true }
    );
  } else {
    boot();
  }
})();
/* PMD_SIMPLE_ADD_RESERVATION_CARD_V460_END */
