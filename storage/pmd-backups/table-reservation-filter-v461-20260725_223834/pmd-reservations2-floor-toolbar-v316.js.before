    document.readyState === 'loading'
  ) {
    document.addEventListener(
      'DOMContentLoaded',
      boot,
      { once: true }
    );
  } else {
    boot();
  }
})();
/* PMD_DATE_BUTTON_BRIDGE_V454_END */

/* PMD_DATE_NOTIFICATION_EXCLUSIVE_V455_BEGIN */
(function () {
  'use strict';

  var route = String(
    window.location.pathname || ''
  ).replace(/\/+$/, '');

  if (
    route !== '/admin/reservations' &&
    route !== '/admin/reservations2'
  ) {
    return;
  }

  if (
    window.PMDReservations2DateNotificationExclusiveV455
  ) {
    return;
  }

  var VERSION = '4.5.5';

  var VISIBLE_DATE_BUTTON_ID =
    'pmd-r2-date-button-v430';

  var WORKING_DATE_BUTTON_ID =
    'pmd-r2-date-button-v318';

  var DATE_PANEL_ID =
    'pmd-r2-date-panel-v318';

  var STYLE_ID =
    'pmd-r2-date-notification-exclusive-v455-style';

  var actionInProgress = false;
  var observer = null;

  function visibleDateButton() {
    return document.getElementById(
      VISIBLE_DATE_BUTTON_ID
    );
  }

  function workingDateButton() {
    return document.getElementById(
      WORKING_DATE_BUTTON_ID
    );
  }

  function datePanel() {
    return document.getElementById(
      DATE_PANEL_ID
    );
  }

  function dateIsOpen() {
    var button = workingDateButton();
    var panel = datePanel();

    return Boolean(
      (
        button &&
        button.getAttribute('aria-expanded') === 'true'
      ) ||
      (
        panel &&
        (
          panel.classList.contains('show') ||
          panel.classList.contains('is-open') ||
          panel.getAttribute('aria-hidden') === 'false'
        )
      )
    );
  }

  function closeDatePanel() {
    if (actionInProgress || !dateIsOpen()) {
      return;
    }

    var button = workingDateButton();

    if (!button) {
      return;
    }

    actionInProgress = true;

    try {
      button.click();
    } finally {
      window.setTimeout(function () {
        actionInProgress = false;
      }, 50);
    }
  }

  function notificationRoot() {
    return (
      document.getElementById('notif-root') ||
      document.querySelector(
        '[data-notification-root]'
      ) ||
      document.querySelector(
        '.pmd-notification-root'
      )
    );
  }

  function notificationTriggers() {
    var selectors = [
      '#notif-root .dropdown-toggle',
      '#notif-root [data-bs-toggle="dropdown"]',
      '#notif-root [data-toggle="dropdown"]',
      '[aria-label*="notification" i]',
      '[title*="notification" i]',
      '[aria-label*="benachrichtigung" i]',
      '[title*="benachrichtigung" i]'
    ];

    return Array.prototype.slice.call(
      document.querySelectorAll(
        selectors.join(',')
      )
    ).filter(function (element) {
      return !element.closest(
        '#' + DATE_PANEL_ID
      );
    });
  }

  function notificationIsOpen() {
    var root = notificationRoot();

    if (
      root &&
      (
        root.classList.contains('show') ||
        root.classList.contains('is-open') ||
        root.classList.contains('open')
      )
    ) {
      return true;
    }

    return notificationTriggers().some(
      function (trigger) {
        return (
          trigger.getAttribute(
            'aria-expanded'
          ) === 'true'
        );
      }
    );
  }

  function closeNotification() {
    if (
      actionInProgress ||
      !notificationIsOpen()
    ) {
      return;
    }

    var openTrigger =
      notificationTriggers().find(
        function (trigger) {
          return (
            trigger.getAttribute(
              'aria-expanded'
            ) === 'true'
          );
        }
      );

    if (openTrigger) {
      actionInProgress = true;

      try {
        openTrigger.click();
      } finally {
        window.setTimeout(function () {
          actionInProgress = false;
        }, 50);
      }

      return;
    }

    var root = notificationRoot();

    if (!root) {
      return;
    }

    root.classList.remove(
      'show',
      'is-open',
      'open'
    );

    root.querySelectorAll(
      '.show,.is-open,.open'
    ).forEach(function (element) {
      element.classList.remove(
        'show',
        'is-open',
        'open'
      );
    });
  }

  function isNotificationTrigger(target) {
    return Boolean(
      target &&
      target.closest(
        [
          '#notif-root .dropdown-toggle',
          '#notif-root [data-bs-toggle="dropdown"]',
          '#notif-root [data-toggle="dropdown"]',
          '[aria-label*="notification" i]',
          '[title*="notification" i]',
          '[aria-label*="benachrichtigung" i]',
          '[title*="benachrichtigung" i]'
        ].join(',')
      )
    );
  }

  function removeCloseIcon() {
    var panel = datePanel();

    if (!panel) {
      return;
    }

    panel.querySelectorAll(
      [
        '[data-r2-date-close]',
        '[data-date-close]',
        '[data-dismiss="modal"]',
        '[data-bs-dismiss="modal"]',
        'button[aria-label*="close" i]',
        'button[title*="close" i]',
        '.pmd-r2-date-close',
        '.pmd-r2-date-panel__close'
