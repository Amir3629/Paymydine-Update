      style.id = STYLE_ID;

      style.textContent = `
/* حذف دکمه ضربدر Date Range */
#${DATE_PANEL_ID} [data-r2-date-close],
#${DATE_PANEL_ID} [data-date-close],
#${DATE_PANEL_ID} [data-dismiss="modal"],
#${DATE_PANEL_ID} [data-bs-dismiss="modal"],
#${DATE_PANEL_ID} button[aria-label*="close" i],
#${DATE_PANEL_ID} button[title*="close" i],
#${DATE_PANEL_ID} .pmd-r2-date-close,
#${DATE_PANEL_ID} .pmd-r2-date-panel__close {
  display: none !important;
}

/*
 * دکمه‌های غیرفعال:
 * Hover با متن تیره و کاملاً خوانا
 */
#${DATE_PANEL_ID} [data-range]:not(.is-active):hover,
#${DATE_PANEL_ID} [data-range]:not(.is-active):focus,
#${DATE_PANEL_ID} [data-range]:not(.is-active):focus-visible,
#${DATE_PANEL_ID} button[data-range]:not(.is-active):hover,
#${DATE_PANEL_ID} button[data-range]:not(.is-active):focus {
  color: #14283e !important;
  background: #f3f7fb !important;
  border-color: #b8cde0 !important;
}

/* متن تمام عناصر داخلی دکمه نیز تیره بماند */
#${DATE_PANEL_ID} [data-range]:not(.is-active):hover *,
#${DATE_PANEL_ID} [data-range]:not(.is-active):focus * {
  color: #14283e !important;
}

/*
 * دکمه فعال:
 * زمینه تیره و متن سفید
 */
#${DATE_PANEL_ID} [data-range].is-active,
#${DATE_PANEL_ID} [data-range][aria-pressed="true"] {
  color: #ffffff !important;
  background: #0b3b36 !important;
  border-color: #0b3b36 !important;
}

#${DATE_PANEL_ID} [data-range].is-active *,
#${DATE_PANEL_ID} [data-range][aria-pressed="true"] * {
  color: #ffffff !important;
}
`;

      document.head.appendChild(style);
    }

    apply();

    observer =
      new MutationObserver(function (mutations) {
        var relevant = mutations.some(
          function (mutation) {
            return (
              mutation.type === 'childList' ||
              mutation.type === 'attributes'
            );
          }
        );

        if (relevant) {
          window.requestAnimationFrame(
            apply
          );
        }
      });

    observer.observe(
      document.body,
      {
        childList: true,
        subtree: true,
        attributes: true,
        attributeFilter: [
          'class',
          'aria-expanded',
          'aria-hidden'
        ]
      }
    );

    window
      .PMDReservations2DateNotificationExclusiveV455 = {
        version: VERSION,

        refresh: apply,

        closeDate: closeDatePanel,

        closeNotification:
          closeNotification,

        audit: function () {
          var panel = datePanel();

          return {
            version: VERSION,
            datePanel: Boolean(panel),
            dateOpen: dateIsOpen(),
            notificationOpen:
              notificationIsOpen(),
            closeButtonsVisible: panel
              ? Array.prototype.slice.call(
                  panel.querySelectorAll(
                    'button'
                  )
                ).filter(function (button) {
                  var value = String(
                    button.textContent || ''
                  ).replace(/\s+/g, '');

                  return (
                    (
                      value === '×' ||
                      value === '✕' ||
                      value === '✖'
                    ) &&
                    getComputedStyle(button)
                      .display !== 'none'
                  );
                }).length
              : 0
          };
        }
      };

    console.info(
      '[PMD Date + Notification Exclusive V4.5.5] Ready',
      window
        .PMDReservations2DateNotificationExclusiveV455
        .audit()
    );
  }

  if (
    document.readyState === 'loading'
  ) {
    document.addEventListener(
      'DOMContentLoaded',
      boot,
      { once: true }
    );
  } else {
    boot();
  }
})();
