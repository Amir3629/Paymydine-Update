  ) {
    return;
  }

  var VERSION = '4.5.9';
  var STYLE_ID =
    'pmd-reservation-card-style-v459';

  function install() {
    var old =
      document.getElementById(STYLE_ID);

    if (old) {
      old.remove();
    }

    var style =
      document.createElement('style');

    style.id = STYLE_ID;

    style.textContent = `
/*
 * Table number:
 * same blue family as Pending Confirmations KPI
 */
#pmd-r2-reservation-grid-v320
.pmd-r2-table-number-v458 {
  min-width: 48px !important;
  width: auto !important;
  height: 48px !important;
  padding: 0 15px !important;

  border: 2px solid #21a8d8 !important;
  border-radius: 999px !important;

  background: #dff5fc !important;
  color: #087aa5 !important;

  font-size: 19px !important;
  font-weight: 950 !important;
  line-height: 1 !important;
  text-align: center !important;

  box-shadow: none !important;
}

/*
 * Three-dot trigger:
 * no frame, no circle, no background, no shadow
 */
#pmd-r2-reservation-grid-v320
.pmd-r2-card-menu-trigger-v458 {
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;

  width: 34px !important;
  min-width: 34px !important;
  height: 40px !important;
  padding: 0 !important;
  margin: 0 !important;

  border: 0 !important;
  border-radius: 0 !important;

  background: transparent !important;
  color: #14283e !important;

  box-shadow: none !important;
  outline: none !important;

  font-family: Arial, sans-serif !important;
  font-size: 29px !important;
  font-weight: 900 !important;
  line-height: 1 !important;

  cursor: pointer !important;

  transition:
    transform .15s ease,
    color .15s ease,
    opacity .15s ease !important;
}

#pmd-r2-reservation-grid-v320
.pmd-r2-card-menu-trigger-v458:hover,
#pmd-r2-reservation-grid-v320
.pmd-r2-card-menu-trigger-v458:focus-visible,
#pmd-r2-reservation-grid-v320
.pmd-r2-card-menu-trigger-v458[aria-expanded="true"] {
  border: 0 !important;
  background: transparent !important;
  color: #087aa5 !important;
  box-shadow: none !important;

  transform: translateY(-1px) !important;
  opacity: 1 !important;
}

/*
 * Remove any inherited circular button styling
 */
#pmd-r2-reservation-grid-v320
.pmd-r2-card-menu-wrap-v458
button.pmd-r2-card-menu-trigger-v458::before,
#pmd-r2-reservation-grid-v320
.pmd-r2-card-menu-wrap-v458
button.pmd-r2-card-menu-trigger-v458::after {
  display: none !important;
  content: none !important;
}
`;

    document.head.appendChild(style);
  }

  function boot() {
    install();

    window.PMDReservationCardStyleV459 = {
      version: VERSION,
      refresh: install
    };

    console.info(
      '[PMD Reservation Card Style V4.5.9] Ready'
    );
  }

  if (
    document.readyState === 'loading'
  ) {
    document.addEventListener(
      'DOMContentLoaded',
      boot,
      { once: true }
    );
  } else {
    boot();
  }
})();
