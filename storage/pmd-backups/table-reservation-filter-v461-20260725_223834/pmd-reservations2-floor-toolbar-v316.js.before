(function () {
  'use strict';

  var route = String(
    window.location.pathname || ''
  ).replace(/\/+$/, '');

  if (
    route !== '/admin/reservations' &&
    route !== '/admin/reservations2'
  ) {
    return;
  }

  var VERSION = '4.5.7';

  var DATE_BUTTON_ID =
    'pmd-r2-date-button-v430';

  var STYLE_ID =
    'pmd-reservation-card-clean-v457-style';

  function closeNotificationPanel() {
    var selectors = [
      '#notif-root [aria-expanded="true"]',
      '#notif-root [data-bs-toggle="dropdown"]',
      '#notif-root [data-toggle="dropdown"]',
      '#notif-root .dropdown-toggle',
      '[aria-label*="notification" i][aria-expanded="true"]',
      '[title*="notification" i][aria-expanded="true"]',
      '[aria-label*="benachrichtigung" i][aria-expanded="true"]',
      '[title*="benachrichtigung" i][aria-expanded="true"]'
    ];

    var triggers = Array.prototype.slice.call(
      document.querySelectorAll(
        selectors.join(',')
      )
    );

    var trigger = triggers.find(function (element) {
      return (
        element.getAttribute('aria-expanded') === 'true'
      );
    });

    /*
     * Bootstrap 5
     */
    if (
      trigger &&
      window.bootstrap &&
      window.bootstrap.Dropdown
    ) {
      try {
        var instance =
          window.bootstrap.Dropdown.getInstance(
            trigger
          );

        if (instance) {
          instance.hide();
        }
      } catch (error) {}
    }

    /*
     * Bootstrap 4 / jQuery
     */
    if (
      trigger &&
      window.jQuery &&
      typeof window.jQuery.fn.dropdown === 'function'
    ) {
      try {
        window.jQuery(trigger).dropdown('hide');
      } catch (error) {}
    }

    /*
     * Native trigger fallback
     */
    if (
      trigger &&
      trigger.getAttribute('aria-expanded') === 'true'
    ) {
      try {
        trigger.click();
      } catch (error) {}
    }

    /*
     * Final DOM cleanup fallback
     */
    var root =
      document.getElementById('notif-root') ||
      document.querySelector(
        '[data-notification-root]'
      ) ||
      document.querySelector(
        '.pmd-notification-root'
      );

    if (root) {
      root.querySelectorAll(
        '[aria-expanded="true"]'
      ).forEach(function (element) {
        element.setAttribute(
          'aria-expanded',
          'false'
        );
      });

      root.querySelectorAll(
        '.show,.open,.is-open'
      ).forEach(function (element) {
        element.classList.remove(
          'show',
          'open',
          'is-open'
        );
      });

      root.classList.remove(
        'show',
        'open',
        'is-open'
      );
    }

    document.querySelectorAll(
      [
        '#notif-root + .dropdown-menu.show',
        '#notif-root .dropdown-menu.show',
        '.notification-dropdown.show',
        '.notifications-dropdown.show',
        '[data-notification-panel].show',
        '[data-notification-panel].is-open'
      ].join(',')
    ).forEach(function (panel) {
      panel.classList.remove(
        'show',
        'open',
        'is-open'
      );

      panel.setAttribute(
        'aria-hidden',
        'true'
      );
    });
  }

  /*
   * Date button is handled by V454.
   * We do not stop or replace its click.
   * We only close Notification immediately before and
   * immediately after the normal Date handler runs.
   */
  document.addEventListener(
    'click',
    function (event) {
      var button = event.target.closest(
        '#' + DATE_BUTTON_ID
      );

      if (!button) {
        return;
      }

      closeNotificationPanel();

      window.setTimeout(
        closeNotificationPanel,
        0
      );

      window.setTimeout(
        closeNotificationPanel,
        80
      );
    },
    true
  );

  function installStyle() {
    if (document.getElementById(STYLE_ID)) {
      return;
    }

    var style =
      document.createElement('style');

    style.id = STYLE_ID;

    style.textContent = `
#pmd-r2-reservation-grid-v320
.pmd-r2-clean-res-card-v457 {
  padding: 18px !important;
}

/* Table frame left and Edit icon right */
#pmd-r2-reservation-grid-v320
.pmd-r2-clean-card-head-v457 {
  display: flex !important;
  align-items: center !important;
  justify-content: space-between !important;
  gap: 12px !important;
  min-height: 42px !important;
  margin: 0 0 14px !important;
}

/* Only the framed table name/number */
#pmd-r2-reservation-grid-v320
.pmd-r2-table-frame-v457 {
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  min-height: 38px !important;
  max-width: calc(100% - 54px) !important;
  padding: 7px 13px !important;
  border: 1.5px solid #ff9e4a !important;
  border-radius: 999px !important;
  background: #fff8f1 !important;
  color: #973514 !important;
  font-size: 13px !important;
  font-weight: 900 !important;
  line-height: 1.2 !important;
  overflow: hidden !important;
  text-overflow: ellipsis !important;
  white-space: nowrap !important;
}

/* One Edit button, top right */
#pmd-r2-reservation-grid-v320
.pmd-r2-top-edit-v457 {
  position: relative !important;
  z-index: 5 !important;
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  flex: 0 0 40px !important;
  width: 40px !important;
  height: 40px !important;
  margin: 0 !important;
  border: 1.5px solid #cfdeec !important;
  border-radius: 999px !important;
  background: #ffffff !important;
  color: #14283e !important;
  font-size: 17px !important;
  text-decoration: none !important;
}

/* Safety: raw table counter must never appear */
#pmd-r2-reservation-grid-v320
.pmd-r2-clean-res-card-v457
.pmd-v35-table-no {
  display: none !important;
}

/* Safety: no middle Scheduled pill */
#pmd-r2-reservation-grid-v320
.pmd-r2-clean-res-card-v457
> div[style*="display:flex"][style*="gap:8px"] {
  display: none !important;
}

/* Safety: no bottom Edit or status row */
#pmd-r2-reservation-grid-v320
.pmd-r2-clean-res-card-v457
.pmd-w5-card-actions {
  display: none !important;
}

/* Card name */
#pmd-r2-reservation-grid-v320
.pmd-r2-clean-res-card-v457 > h2 {
  margin: 0 0 14px !important;
}

/* Booking date */
#pmd-r2-reservation-grid-v320
.pmd-r2-booking-date-v457 {
  margin-bottom: 0 !important;
}
`;

    document.head.appendChild(style);
  }

  function boot() {
    installStyle();

    window.PMDReservationCardCleanV457 = {
      version: VERSION,
      closeNotification:
        closeNotificationPanel,
      refresh: installStyle
    };

