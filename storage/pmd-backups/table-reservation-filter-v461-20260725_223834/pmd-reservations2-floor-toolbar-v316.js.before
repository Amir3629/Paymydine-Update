     * و هیچ class یا aria-label مشخصی ندارد.
     */
    panel.querySelectorAll('button').forEach(
      function (button) {
        var text = String(
          button.textContent || ''
        ).replace(/\s+/g, '');

        if (
          text === '×' ||
          text === '✕' ||
          text === '✖'
        ) {
          button.hidden = true;

          button.style.setProperty(
            'display',
            'none',
            'important'
          );

          button.setAttribute(
            'aria-hidden',
            'true'
          );
        }
      }
    );
  }

  function apply() {
    removeCloseIcon();

    var visible = visibleDateButton();

    if (visible) {
      visible.setAttribute(
        'data-pmd-exclusive-popover',
        'v455'
      );
    }

    var panel = datePanel();

    if (panel) {
      panel.setAttribute(
        'data-pmd-exclusive-popover',
        'v455'
      );
    }
  }

  document.addEventListener(
    'click',
    function (event) {
      if (actionInProgress) {
        return;
      }

      var clickedDateButton =
        event.target.closest(
          '#' + VISIBLE_DATE_BUTTON_ID
        );

      if (clickedDateButton) {
        /*
         * قبل از بازشدن Date Range،
         * Notification بسته می‌شود.
         * خود event دکمه Date متوقف نمی‌شود.
         */
        closeNotification();
        return;
      }

      if (
        isNotificationTrigger(event.target)
      ) {
        /*
         * قبل از بازشدن Notification،
         * Date Range بسته می‌شود.
         */
        closeDatePanel();
      }
    },
    true
  );

  function boot() {
    if (!document.getElementById(STYLE_ID)) {
      var style =
