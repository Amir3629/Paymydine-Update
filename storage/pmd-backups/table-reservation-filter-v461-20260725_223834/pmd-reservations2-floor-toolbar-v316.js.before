(function(){
'use strict';
var route=String(location.pathname||'').replace(/\/+$/,'');if(route!=='/admin/reservations2'&&route!=='/admin/reservations')return;
var VERSION='4.4.0',FLOOR_ID='pmd-r2-shared-floor-canvas-v310',TOOLBAR_ID='pmd-r2-floor-toolbar-v316',FILTER_ID='pmd-r2-date-filter-v317',DATE_BTN_ID='pmd-r2-date-button-v430',SECTION_ID='pmd-r2-reservation-cards-v320',GRID_ID='pmd-r2-reservation-grid-v320',STYLE_ID='pmd-r2-waiter-cards-v430-style',STORAGE_KEY='pmd.reservations2.dateRange.v2';
var rendering=false,scheduled=false,observer=null,eventsBound=false;
var state={start:startOfDay(new Date()),end:endOfDay(new Date()),tableId:null,tableName:null,allDates:true};
function floor(){return document.getElementById(FLOOR_ID)}
function bootData(){return window.PMD_RESERVATIONS2_BOOT||{}}
function reservations(){return Array.isArray(bootData().reservations)?bootData().reservations:[]}
function clean(v){return String(v==null?'':v).replace(/\s+/g,' ').trim()}
function esc(v){return clean(v).replace(/[&<>'"]/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]})}
function pad(v){return String(v).padStart(2,'0')}
function startOfDay(v){var d=new Date(v);d.setHours(0,0,0,0);return d}
function endOfDay(v){var d=new Date(v);d.setHours(23,59,59,999);return d}
function addDays(v,n){var d=new Date(v);d.setDate(d.getDate()+n);return d}
function dateKey(v){return v.getFullYear()+'-'+pad(v.getMonth()+1)+'-'+pad(v.getDate())}
function parseDate(v,end){var p=String(v||'').split('-').map(Number);if(p.length!==3||p.some(function(x){return!Number.isFinite(x)}))return null;var d=new Date(p[0],p[1]-1,p[2]);return Number.isNaN(d.getTime())?null:(end?endOfDay(d):startOfDay(d))}
function validRange(a,b){return!!(a&&b&&!Number.isNaN(a.getTime())&&!Number.isNaN(b.getTime())&&b>=a)}
function humanDate(v){try{return new Intl.DateTimeFormat(undefined,{day:'numeric',month:'short',year:'numeric'}).format(v)}catch(e){return dateKey(v)}}
function humanTime(v){try{return new Intl.DateTimeFormat(undefined,{hour:'2-digit',minute:'2-digit'}).format(v)}catch(e){return pad(v.getHours())+':'+pad(v.getMinutes())}}
function rangeLabel(){return state.allDates?'All dates':(dateKey(state.start)===dateKey(state.end)?humanDate(state.start):humanDate(state.start)+' – '+humanDate(state.end))}
