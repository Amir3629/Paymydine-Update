########################################
server {






    # --- Short compat endpoints (frontend may call without /api/v1) ---
    location = /settings-wrapped { return 302 /api/v1/settings-wrapped; }
    location = /tax-settings     { return 302 /api/v1/tax-settings; }
    # --- /Short compat endpoints ---
    server_name paymydine.com www.paymydine.com;

    # PMD_BACKEND_COMPAT_ROUTES_BEFORE_NEXT_20260606
    # These endpoints must go to Laravel/PHP, not Next.js.
    location = /api/health {
        try_files $uri /index.php?$query_string;
    }

    location = /api/v1/settings-wrapped {
        try_files $uri /index.php?$query_string;
    }

    location = /vat-settings {
        try_files $uri /index.php?$query_string;
    }

    location = /validate-coupon {
        try_files $uri /index.php?$query_string;
    }

    location ^~ /api/media/ {
        try_files $uri /index.php?$query_string;
    }




    # PMD botanical v0 exact helper app






    # PMD botanical v0 exact helper app
    location = /dev/botanical-v0-exact {
        return 301 /dev/botanical-v0-exact/;
    }

    location ^~ /dev/botanical-v0-exact/ {
        proxy_pass http://127.0.0.1:3002;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_read_timeout 300;
        proxy_send_timeout 300;
    }

    # Modern Green standalone preview
    location = /newfrontend {
        return 308 /newfrontend/;
    }

    location ^~ /newfrontend/ {
        proxy_pass http://127.0.0.1:3012;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_cache_bypass $http_upgrade;

        proxy_read_timeout 90s;
        proxy_send_timeout 90s;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/paymydine.com/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/paymydine.com/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot


}

