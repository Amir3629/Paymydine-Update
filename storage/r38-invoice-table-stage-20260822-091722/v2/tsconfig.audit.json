{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "types": [],
    "skipLibCheck": true,
    "noImplicitAny": false,
    "jsx": "preserve"
  },
  "include": [
    "tools/offline-stubs.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    ".next"
  ]
}
