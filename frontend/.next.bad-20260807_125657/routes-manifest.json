{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [
      {
        "source": "/api/v1/:path*",
        "destination": "http://127.0.0.1:8000/api/v1/:path*",
        "regex": "^/api/v1(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
      },
      {
        "source": "/api/media/:path*",
        "destination": "http://127.0.0.1:8000/api/media/:path*",
        "regex": "^/api/media(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
      },
      {
        "source": "/:path*",
        "destination": "/:path*",
        "has": [
          {
            "type": "host",
            "value": "(?<tenant>[^.]+)\\.paymydine\\.com"
          }
        ],
        "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
      },
      {
        "source": "/:path*",
        "destination": "/:path*",
        "has": [
          {
            "type": "host",
            "value": "localhost:3000"
          }
        ],
        "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
      },
      {
        "source": "/:path*",
        "destination": "/:path*",
        "has": [
          {
            "type": "host",
            "value": "localhost:3001"
          }
        ],
        "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
      }
    ],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/admin/menu/[id]",
      "regex": "^/admin/menu/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/admin/menu/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/table/[table_id]",
      "regex": "^/table/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPtable_id": "nxtPtable_id"
      },
      "namedRegex": "^/table/(?<nxtPtable_id>[^/]+?)(?:/)?$"
    },
    {
      "page": "/table/[table_id]/menu",
